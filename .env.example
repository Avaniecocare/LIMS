# LIMS backend configuration for local development. Copy to .env.
# Everything here is fictional. Real company values live outside this repository;
# see clients/_template/ in LIMS-Deploy.

# --- Infrastructure -------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lims:lims@localhost:5432/lims
# DATABASE_READ_URL=            # optional replica for reports and dashboards
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY=false
# SETUP_TOKEN=                  # when set, the first-run wizard requires this token
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=           # address browsers use for signed URLs, if different
S3_REGION=us-east-1
S3_BUCKET=lims
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=lab@bluepeak.example
# SMTP_TRANSPORT=json           # keep mail in memory instead of sending
LOG_LEVEL=info

# --- Company (fictional) --------------------------------------------------
COMPANY_PRODUCT_NAME="BluePeak LIMS"
COMPANY_NAME="BluePeak Testing Labs"
COMPANY_LEGAL_NAME="BluePeak Testing Labs Private Limited"
COMPANY_GSTIN="27AAAAA0000A1Z2"
COMPANY_PAN="AAAAA0000A"
COMPANY_CIN="U74999MH2020PTC000000"
COMPANY_STATE="Maharashtra"
COMPANY_GST_STATE_CODE="27"
COMPANY_SAC_CODE="998346"
COMPANY_SAC_DESCRIPTION="Technical testing and analysis services"
COMPANY_REGISTERED_ADDRESS="Unit 1, Example Industrial Estate, Pune 411001"
COMPANY_LAB_ADDRESS="Unit 1, Example Industrial Estate, Pune 411001"
COMPANY_PHONE="+91 20 0000 0000"
COMPANY_EMAIL="lab@bluepeak.example"
COMPANY_WEBSITE="https://bluepeak.example"
COMPANY_REPORT_VERIFICATION_EMAIL="verify@bluepeak.example"
COMPANY_BANK_ACCOUNT_NAME="BluePeak Testing Labs Private Limited"
COMPANY_BANK_ACCOUNT_NUMBER="000000000000"
COMPANY_BANK_NAME="Example Bank"
COMPANY_BANK_BRANCH="Pune Main"
COMPANY_BANK_IFSC="EXMP0000001"
COMPANY_BANK_SWIFT=
COMPANY_BRANDING_DIR="./branding-demo/bluepeak"
