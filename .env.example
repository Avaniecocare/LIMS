# LIMS server configuration. Copy to .env and fill in. Placeholders only: never commit real values.
#
# Only server and deployment settings belong here, plus BRAND_NAME. Everything about the laboratory itself
# (name, legal details, GSTIN, bank account, NABL details, logo, colours, email wording, which modules are on)
# is set by the lab's administrator in the app: the setup wizard after the first sign-in, then Admin.
# Those changes apply at once, without a restart, and upgrades never overwrite them.

# --- Brand -------------------------------------------------------------------
# The name shown until the administrator sets the lab's own name and app name. The only branding value here.
BRAND_NAME=LIMS

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Health and metrics for monitoring, on their own port. Never publish it. 0 turns it off.
# OPS_PORT=9464
# Behind a reverse proxy, so client addresses and HTTPS are read correctly: how many proxies (1 behind one load
# balancer), or their addresses. true believes every X-Forwarded-For entry: only behind a proxy that replaces it.
TRUST_PROXY=false

# --- Addresses ---------------------------------------------------------------
# Where people open the app. Also used in emails, and for the QR verification links printed on reports
# (<FRONTEND_ORIGIN>/verify/...) and phone-upload links. Requests from any other origin are refused (CORS).
FRONTEND_ORIGIN=http://localhost:5173
# Where the API is reached from browsers (logos, signed file links).
PUBLIC_API_URL=http://localhost:3000

# --- Database (PostgreSQL 16+) -----------------------------------------------
DATABASE_URL=postgresql://lims:lims@localhost:5432/lims
# Optional read replica for reports and dashboards.
# DATABASE_READ_URL=
DATABASE_POOL_SIZE=10

# --- Redis (sessions, background jobs, cache) ---------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Sessions and security ---------------------------------------------------
# At least 32 random characters, unique per installation (openssl rand -base64 48). Production refuses example values.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_IDLE_MINUTES=30
# Sessions end this many hours after sign-in, however active.
SESSION_MAX_HOURS=12
# true whenever the app is served over HTTPS (always in production).
COOKIE_SECURE=false
# SESSION_COOKIE_NAME=lims_sid
# SESSION_COOKIE_DOMAIN=
# When set, the first-run screen asks for this token before anyone can create the first administrator.
# Recommended for any install reachable from the internet before setup is finished.
# SETUP_TOKEN=

# --- File storage (S3-compatible: AWS S3, MinIO on-premise, etc.) ---------------
S3_ENDPOINT=http://localhost:9000
# The address browsers use for signed file links, if different from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=lims
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
# Largest upload accepted, in bytes (default 15 MB).
# MAX_UPLOAD_BYTES=15728640

# --- Email (SMTP) --------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# The sender address. The display name is the lab's name from the admin panel.
SMTP_FROM=lab@example.com
# json keeps mail in memory instead of sending (development and tests).
# SMTP_TRANSPORT=json

# --- Help assistant ("Ask AI" on the help site) ---------------------------------
# Answers questions from the published documentation only, through this server; the browser never sees a key.
# Off unless ENABLE_AI_ASSISTANT=true and a provider is usable. Use a SEPARATE Anthropic API key with a spending
# limit set in the Anthropic Console, so this feature can never spend more than you decide.
# ENABLE_AI_ASSISTANT=false
# AI_PROVIDER=anthropic            # anthropic; openai-compatible (any service with that interface, your own included); or mock (offline, for development and tests)
# AI_BASE_URL=                     # openai-compatible only, for example https://llm.example.com/v1
# AI_PRICE_INPUT=                  # US dollars per million tokens; needed for any model the server does not know (0 for your own)
# AI_PRICE_OUTPUT=
# AI_API_KEY=                      # server-side only; never in the UI, logs or git
# AI_MODEL=claude-haiku-5-5        # low cost; claude-sonnet-5-5 for better answers at higher cost
# Asked when the first is busy, down or slow. Same settings with this prefix: _MODEL, _API_KEY, _BASE_URL, _PRICE_INPUT, _PRICE_OUTPUT.
# AI_FALLBACK_PROVIDER=
# Optional vector search on top of keyword search. Without it everything runs locally.
# EMBEDDING_PROVIDER=none          # none or voyage
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=voyage-3.5-lite
# Where the docs build's search index is read from (defaults to <FRONTEND_ORIGIN>/help/help-index.json).
# HELP_INDEX_URL=
# HELP_INDEX_PATH=
# Limits. Anonymous visitors are counted per address (hashed, never stored), signed-in staff per person.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=50
# SIGNED_IN_RATE_LIMIT_PER_DAY=200
# DAILY_BUDGET_LIMIT=1             # US dollars per day; the assistant pauses itself when reached, search keeps working
# MONTHLY_BUDGET_LIMIT=20          # US dollars per calendar month
# MAX_QUESTION_LENGTH=500
# MAX_OUTPUT_TOKENS=800
# Cloudflare Turnstile: a human check for visitors who are not signed in (both values from the Cloudflare dashboard).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# AI_REQUIRE_LOGIN=false           # true: only signed-in staff may ask
# ALLOWED_ORIGINS=                 # extra origins (comma-separated) if the help site is not on the app's own address
# HELP_SUPPORT_EMAIL=              # shown as "Contact support" in the assistant
# HELP_LOG_RETENTION_DAYS=90       # questions are kept, without addresses or personal details, this many days

# --- Optional services ---------------------------------------------------------
# WhatsApp Business Cloud API (Meta). Both values come from WhatsApp Manager > API setup; use a permanent
# system-user token. Leave them empty to keep WhatsApp off. Message templates are chosen in Admin > WhatsApp.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Delivered and read receipts: Meta calls <PUBLIC_API_URL>/api/v1/webhooks/whatsapp (shown in Admin > WhatsApp).
# The app secret is in the Meta app's Settings > Basic; the verify token is any long random text you also enter
# in the app's WhatsApp > Configuration. Without both, messages still send but stay at "sent".
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# GST e-invoicing (IRN from the Invoice Registration Portal). Unset: not set up. The module then stays off until an
# administrator turns it on in Admin, Modules, after the E-invoicing tab shows nothing missing.
#   mock: test IRNs made on this server, for development and demos (printed as TEST; refused with EINVOICE_ENV=production)
#   nic:  the government IRP's direct API, with the credentials from the e-invoice portal's API registration
# EINVOICE_PROVIDER=mock
# EINVOICE_ENV=sandbox                 # or production
# EINVOICE_BASE_URL=                   # sandbox: the address shown after signing in to einv-apisandbox.nic.in; production defaults to https://api.einvoice1.gst.gov.in
# EINVOICE_CLIENT_ID=
# EINVOICE_CLIENT_SECRET=
# EINVOICE_USERNAME=                   # the API user created on the e-invoice portal
# EINVOICE_PASSWORD=
# EINVOICE_GSTIN=                      # the lab's GSTIN the API user belongs to; must match the Lab profile
# EINVOICE_PUBLIC_KEY=                 # the IRP public key (PEM); newlines may be written as \n
# json records messages instead of sending them (development and tests).
# WHATSAPP_TRANSPORT=json
# PIN code auto-fill (India Post's public directory, called from the server). Empty turns it off.
PINCODE_LOOKUP_URL=https://api.postalpincode.in/pincode/
# HTTPS webhook that receives server errors as JSON (no request bodies), for any error tracker.
# ERROR_TRACKING_DSN=

# --- Licence --------------------------------------------------------------------
# Only for images built with a vendor's key: a licence to use at the first start. Later ones are added in Admin, Licence.
# LICENCE=

# --- Upgrading an install configured the old way ---------------------------------
# Older versions read the lab's details from COMPANY_* variables. If they are still present on the first start
# of this version, they are checked and imported into the admin panel once (logo and favicon included); after
# that they are ignored and can be removed. A new installation should not set them.
